# Variables opcionales para docker-compose.yml. Copiar a ".env" (en esta misma carpeta) y completar.
# Sin .env, todo arranca igual con valores de demo: base local, pagos simulados, sin correo ni Google.
# El archivo .env tiene secretos: no se sube al repositorio.

# Base de datos (solo dentro de Docker)
DB_ROOT_PASSWORD=dulcemayor-root
DB_USER=dulcemayor
DB_PASSWORD=dulcemayor-db

# Seguridad: en un despliegue real, poner un secreto largo y aleatorio
JWT_SECRET=

# Direcciones públicas de las apps. Vacías = localhost (8081-8084).
# En el servidor, con el dominio o la IP real, por ejemplo:
#   CLIENT_URL=http://mi-dominio.com:8083
#   ADMIN_URL=http://mi-dominio.com:8084
#   CORS_ORIGENES=http://mi-dominio.com:8081,http://mi-dominio.com:8082,http://mi-dominio.com:8083,http://mi-dominio.com:8084
# CLIENT_URL y ADMIN_URL quedan dentro de las apps al compilar: si se cambian, usar "docker compose up -d --build".
CLIENT_URL=
ADMIN_URL=
CORS_ORIGENES=

# Datos de demostración (cuentas jefe.mza, admin.mza, etc.). false para una base vacía.
DEMO_DATA=true

# Correo (confirmación de pedidos, newsletter, aviso de próxima entrega)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# Ingreso con Google (Auth0). En Auth0 hay que permitir http://localhost:8083 como URL de callback y origen.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=

# Mercado Pago (sin esto se usa la pasarela simulada)
PAGOS_PASARELA=simulada
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_POS_ID=
MERCADOPAGO_WEBHOOK_SECRET=

# Asistente de presupuestos: Ollama corriendo en la PC
CHATBOT_OLLAMA_URL=http://host.docker.internal:11434
