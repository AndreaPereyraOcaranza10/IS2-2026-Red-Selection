# Copiar a .env. Generar dos secretos diferentes antes de iniciar.
DB_USER=abm
DB_PASSWORD=
JWT_SECRET=
FRONTEND_URL=http://localhost
SITE_ADDRESS=:80
SPRING_PROFILES_ACTIVE=prod

# Solo en desarrollo: activar perfil dev y elegir credenciales propias.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Opcional. Google OAuth2: tipo de aplicación Web.
# URI de redirección: https://tu-dominio/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
