pipeline {
    agent any

    tools {
        maven 'Maven'
    }

    stages {
        stage('Compile & Package') {
            steps {
                dir('Trabajo Práctico Guía N2/ejercicio 6/practica/ejercicio-c/tiendaZero') {
                    // Empaqueta el proyecto omitiendo los tests que requieren BD externa
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('Trabajo Práctico Guía N2/ejercicio 6/practica/ejercicio-c/tiendaZero') {
                    sh 'docker build -t tiendazero:latest .'
                }
            }
        }
    }

    post {
        success {
            echo '¡Pipeline exitoso! La imagen tiendazero:latest se generó correctamente.'
        }
        failure {
            echo 'El pipeline falló durante el empaquetado o la creación de la imagen.'
        }
    }
}