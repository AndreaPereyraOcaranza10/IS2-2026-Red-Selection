pipeline {
    agent any

    tools {
        maven 'Maven'
    }

    stages {
        stage('Compile & Test') {
            steps {
                dir('Trabajo Práctico Guía N2/ejercicio 6/practica/ejercicio-c/tiendaZero') {
                    sh 'mvn clean test'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('Trabajo Práctico Guía N2/ejercicio 6/practica/ejercicio-c/tiendaZero') {
                    sh 'docker build -t tiendazero:latest .'
                }
            }
        }
    }

    post {
        success {
            echo '¡Pipeline exitoso! La imagen tiendazero:latest se generó correctamente.'
        }
        failure {
            echo 'El pipeline falló durante las pruebas o el build.'
        }
    }
}