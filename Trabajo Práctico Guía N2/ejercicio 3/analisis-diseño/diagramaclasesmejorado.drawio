        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass Usuario {\n  -id:String\n  -nombre:String\n  -apellido:String\n  -email:String\n  -clave:String\n  +registrarse(nombre:String, apellido:String, email:String, clave:String): void\n  +iniciarSesion(email:String, clave:String): Boolean\n}\nclass Cliente {\n  -telefono:Int\n  +alquilarCabana(cabana:Cabana, fechaInicio:Date, fechaFin:Date, cantidadPersonas:Int): Reserva\n  +consultarMisReservas(): List~Reserva~\n}\nclass Propietario {\n  -telefono:Int\n  +publicarCabana(cabana:Cabana): void\n  +consultarReservas(): List~Reserva~\n}\nclass Cabana {\n  -id:String\n  -nombre:String\n  -localidad:String\n  -direccion:String\n  -capacidad:Int\n  -precioPorNoche:Double\n  +estaDisponible(fechaInicio:Date, fechaFin:Date): Boolean\n  +validarCapacidad(cantidadPersonas:Int): Boolean\n  +agregarPropietario(propietario:Propietario): void\n  +obtenerPrecioNoche(fecha:Date): Double\n}\nclass TarifaTemporada {\n  -temporada:String\n  -fechaDesde:Date\n  -fechaHasta:Date\n  -precioPorNoche:Double\n  +aplicaA(fecha:Date): Boolean\n}\nclass Reserva {\n  -id:String\n  -fechaInicio:Date\n  -fechaFin:Date\n  -cantidadPersonas:Int\n  -montoTotal:Double\n  +calcularDias(): Int\n  +validarMinimoDias(): Boolean\n  +calcularMonto(): Double\n}\nclass Pago {\n  -id:String\n  -monto:Double\n  -fecha:Date\n  +procesar(): Boolean\n}\nclass PagoTarjeta {\n  -numeroTarjeta:String\n  -titular:String\n  +procesar(): Boolean\n}\nclass PagoTransferencia {\n  -cbu:String\n  -comprobante:String\n  +procesar(): Boolean\n}\nclass PagoEfectivo {\n  -lugarDePago:String\n  +procesar(): Boolean\n}\n\nUsuario &lt;|-- Cliente\nUsuario &lt;|-- Propietario\nPago &lt;|-- PagoTarjeta\nPago &lt;|-- PagoTransferencia\nPago &lt;|-- PagoEfectivo\n\nCliente \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Reserva \nReserva \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Cabana \nReserva \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Pago \nPropietario \&quot;1..*\&quot; -- \&quot;1..*\&quot; Cabana \nCabana \&quot;1\&quot; *-- \&quot;1..*\&quot; TarifaTemporada&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="reukiXnlmQYrS4z2DNqv-1">
